      "id": "margarita-classic",
      "name": "Classic Margarita",
      "category": "classics",
      "difficulty": "easy",
      "prepTime": 3,
      "spirits": [
        "tequila"
      ],
      "glass": "coupe",
      "garnish": "lime wheel, salt rim",
      "ingredients": [
        {
          "item": "Tequila Blanco",
          "amount": "2 oz",
          "type": "spirit"
        },
        {
          "item": "Fresh Lime Juice",
          "amount": "1 oz",
          "type": "citrus"
        },
        {
          "item": "Triple Sec",
          "amount": "0.5 oz",
          "type": "liqueur"
        },
        {
          "item": "Simple Syrup",
          "amount": "0.5 oz",
          "type": "syrup"
        }
      ],
      "instructions": [
        "Rim glass with lime and salt",
        "Add all ingredients to shaker with ice",
        "Shake vigorously for 15 seconds",
        "Strain into prepared glass",
        "Garnish with lime wheel"
