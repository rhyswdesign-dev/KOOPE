{
  "expo": {
    "name": "KŌOPE",
    "slug": "KOOPE",
    "version": "1.0.0",
    "scheme": "koope",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A120D"
    },
    "ios": {
      "supportsTablet": true,
      "statusBarStyle": "light",
      "bundleIdentifier": "com.koope.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "KOOPE uses your camera to scan bottles, capture recipe cards, and detect ingredients.",
        "NSPhotoLibraryUsageDescription": "KOOPE needs photo library access so you can import recipe and ingredient photos.",
        "NSPhotoLibraryAddUsageDescription": "KOOPE saves edited photos and recipe images to your library when you choose to export them."
      },
      "associatedDomains": [
        "applinks:koope.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A120D"
      },
      "statusBarStyle": "light",
      "edgeToEdgeEnabled": true,
      "package": "com.koope.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "react-native-iap",
      "expo-video",
      "expo-apple-authentication",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "89eb7254-f763-4d2b-a5d6-27d90b91c908"
      }
    },
    "owner": "frodobagginz"
  }
}
