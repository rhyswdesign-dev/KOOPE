# Supabase Configuration
# Get these from your Supabase project settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth Configuration
# Get these from Google Cloud Console > APIs & Services > Credentials
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Supabase Service Role Key (for data imports/migrations only)
# Get this from Supabase Dashboard > Project Settings > API
# WARNING: Keep this secret! Never commit to version control
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Analytics Configuration
EXPO_PUBLIC_ANALYTICS_PROVIDER=memory
EXPO_PUBLIC_POSTHOG_API_KEY=your-posthog-api-key
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
EXPO_PUBLIC_SEGMENT_WRITE_KEY=your-segment-write-key

# Monetization Configuration
EXPO_PUBLIC_ADMOB_APP_ID=ca-app-pub-your-app-id
EXPO_PUBLIC_ADMOB_LIFE_REWARD_ID=ca-app-pub-your-life-reward-id
EXPO_PUBLIC_ADMOB_XP_BONUS_ID=ca-app-pub-your-xp-bonus-id
EXPO_PUBLIC_APPLOVIN_SDK_KEY=your-applovin-sdk-key

# Development Settings
NODE_ENV=development